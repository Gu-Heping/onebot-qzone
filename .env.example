# ===== 登录（二选一或组合）=====
# 方式一：Cookie 字符串（推荐）。从浏览器登录 QQ 空间后，F12 → Application → Cookies → user.qzone.qq.com，复制为 name1=value1; name2=value2
# 必须包含：uin、p_uin、skey、p_skey（可再带 RK、ptcz 等）
QZONE_COOKIE_STRING=
# 兼容旧变量名
QZONE_COOKIE=

# 方式二：二维码扫码（Playwright 浏览器）。未配置 Cookie 或 Cookie 失效时，会启动浏览器生成二维码到 QZONE_CACHE_PATH/qrcode.png，用手机 QQ 扫码
# 1=启用，0=禁用（默认）
QZONE_ENABLE_QR=0

# Cookie/二维码/缓存目录（登录成功会在此保存 cookies.json，下次启动自动复用）
QZONE_CACHE_PATH=./test_cache
# 是否保存调试用 HTML/JSON dump 文件到 {QZONE_CACHE_PATH}/debug/
QZONE_DEBUG_DUMP=0

# ===== Playwright 配置 =====
# 强制 headless 模式（1=强制 headless，0=强制 headed，空=自动检测 $DISPLAY）
# 服务器环境推荐留空（自动检测）或设为 1
# QZONE_PLAYWRIGHT_HEADLESS=
# 自定义 Chrome 可执行文件路径（留空则自动检测系统 Chrome）
# QZONE_PLAYWRIGHT_EXECUTABLE=
# Playwright channel（默认 chrome，留空则用 Playwright 内置 Chromium）
# QZONE_PLAYWRIGHT_CHANNEL=chrome
# 单次浏览器操作超时（毫秒，默认 15000）
# QZONE_PLAYWRIGHT_TIMEOUT_MS=15000
# 用 Playwright 抓取全量好友列表（需本机 Chrome/Edge）
QZONE_FRIEND_PLAYWRIGHT=0
# 启动探针失败时跳过静默续期，仍用已缓存 Cookie 启动（无头环境 Chrome 不可用时使用）
QZONE_SKIP_REFRESH_ON_START=0
# 启动时做一次写探针（会真实写数据；默认关闭，排障时再开）
QZONE_STARTUP_WRITE_PROBE=0

# ===== 代理（可选）=====
# API 请求代理；图片可单独指定 QZONE_IMAGE_PROXY
# QZONE_PROXY_URL=http://127.0.0.1:7890
# 代理池（逗号分隔，多个出口轮换）
# QZONE_PROXY_POOL=
# 仅图片拉取走代理
# QZONE_IMAGE_PROXY=http://127.0.0.1:7890

# ===== OneBot 服务端配置 =====
# HTTP API 监听地址和端口
ONEBOT_HOST=0.0.0.0
# 未设置时代码内置默认 8080
ONEBOT_PORT=5700
# 访问令牌（为空则不鉴权）
ONEBOT_ACCESS_TOKEN=

# ===== OneBot 事件上报 =====
# HTTP POST 上报地址（多个用逗号分隔）
ONEBOT_HTTP_POST_URLS=
# WebSocket Reverse（反向 WS）地址（多个用逗号分隔）
ONEBOT_WS_REVERSE_URLS=
# 反向 WS 分离模式（可选，不设则用上面的 Universal 连接）
ONEBOT_WS_REVERSE_API_URLS=
ONEBOT_WS_REVERSE_EVENT_URLS=
# 反向 WS 重连间隔（**秒**，默认 5）
ONEBOT_WS_REVERSE_RECONNECT_INTERVAL=5
# HTTP POST body 上限（字节，默认 64 MiB）
# ONEBOT_MAX_REQUEST_BODY_BYTES=67108864

# ===== 轮询配置 =====
# 说说轮询间隔（秒，默认 60；建议 >= 30 避免触发限流）
ONEBOT_POLL_INTERVAL=60
# 轮询数据源: auto / pc / mobile
ONEBOT_EVENT_POLL_SOURCE=auto
# 是否将说说作为 message 事件上报
ONEBOT_EMIT_MESSAGE_EVENTS=1
# 是否上报评论事件
ONEBOT_EMIT_COMMENT_EVENTS=1
# 评论轮询间隔（秒，默认 120）
ONEBOT_COMMENT_POLL_INTERVAL=120
# 是否上报点赞事件（默认开启；关闭可省接口配额）
ONEBOT_EMIT_LIKE_EVENTS=1
# 点赞轮询间隔（秒，默认 180）
ONEBOT_LIKE_POLL_INTERVAL=180
# 是否上报好友动态事件（轮询好友空间动态并推送）
ONEBOT_EMIT_FRIEND_FEED_EVENTS=0
# 好友动态轮询间隔（秒，默认 120）
ONEBOT_FRIEND_FEED_POLL_INTERVAL=120
# 推送事件中附带图片 base64（默认 1；0=关闭）
ONEBOT_ATTACH_IMAGE_DATA=1
# 是否经 WS 下发 meta_event 心跳（默认 1；每 30s 一条，下游若全量打日志会像「一直在上报」可设 0）
ONEBOT_EMIT_HEARTBEAT_EVENTS=1
# 首次启动静默建立基线：1=不推送历史说说/评论/点赞（默认）；0=按 seen 状态回放
ONEBOT_BASELINE_ON_FIRST_RUN=1
# 调试模式（输出详细事件日志；journalctl --user -u onebot-qzone -f）
# 推送调试：1 时 Hub 打印 [push][publish]/[push][dedupe] 指纹；Poller 打印 [push][seen] 等
ONEBOT_EVENT_DEBUG=0

# ===== 即时点赞流水线（scripts/instant-like.ts）=====
# 完整参数说明见 docs/INSTANT_LIKE.md；以下仅为常用项
# 试运行：只看候选，不真实点赞
QZONE_INSTANT_LIKE_DRY_RUN=0
# 轮询间隔（毫秒）
QZONE_INSTANT_LIKE_INTERVAL_MS=5000
# 每轮最多点赞数
QZONE_INSTANT_LIKE_MAX_LIKES_PER_ROUND=3
# feed 来源策略: playwright_first / feeds3_first / playwright_only / feeds3_only
QZONE_INSTANT_LIKE_SOURCE=playwright_first
# 0 = 完全禁用 Playwright 动态抓取/页面内点赞（仅走 feeds3 与 HTTP 点赞）
QZONE_INSTANT_LIKE_PLAYWRIGHT=1
